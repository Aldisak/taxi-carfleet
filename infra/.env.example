# ═════════════════════════════════════════════════════════════════════════════
# Production environment for infra/docker-compose.prod.yml.
#
# Copy to infra/.env (or /opt/taxi/.env on the VPS) and fill in REAL values.
# infra/.env is gitignored and MUST NEVER be committed. This .example file carries
# placeholder values only — safe to commit, and complete enough that
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.example config
# interpolates cleanly.
# ═════════════════════════════════════════════════════════════════════════════

# ── Domain / TLS ─────────────────────────────────────────────────────────────
# Apex domain; fleets live at {slug}.${DOMAIN} (demo.example.cz, second.example.cz).
DOMAIN=example.cz
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=ops@example.cz

# DNS-01 wildcard challenge token — set the ONE matching your DNS host and the
# acme_dns line in infra/Caddyfile. Leave the other blank.
CLOUDFLARE_API_TOKEN=cf-dns-edit-token-goes-here
HETZNER_DNS_API_TOKEN=

# ── Image registry / tags (set by CI; override for manual deploys) ───────────
# GHCR owner (org or user) — images are ghcr.io/${GHCR_OWNER}/taxi-*.
GHCR_OWNER=your-github-owner
API_TAG=latest
WEB_TAG=latest
CADDY_TAG=latest
BACKUP_TAG=latest

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=taxi
POSTGRES_USER=taxi
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT (issued by the API) ──────────────────────────────────────────────────
# Key MUST be >= 32 chars. Generate: openssl rand -base64 48
JWT_KEY=change-me-jwt-signing-key-min-32-characters-long
JWT_ISSUER=taxi-api
JWT_AUDIENCE=taxi-clients

# ── SMS provider (Notifications:SmsProvider) ─────────────────────────────────
# One of: Console (logs only), GoSms, SmsBrana.
SMS_PROVIDER=GoSms
GOSMS_CLIENT_ID=your-gosms-client-id
GOSMS_CLIENT_SECRET=your-gosms-client-secret
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a key pair once (e.g. `npx web-push generate-vapid-keys`).
VAPID_SUBJECT=mailto:ops@example.cz
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Customer tracking-link HMAC ──────────────────────────────────────────────
# Generate: openssl rand -base64 32
TRACKING_HMAC_KEY=change-me-tracking-hmac-key

# ── Ops fleet (5xx alert recipients + disk-alert SMS target, WI A3) ─────────
OPS_FLEET_SLUG=ops

# ── Backups → S3-compatible object storage (rclone; Hetzner OS or Backblaze B2)
# Provider: use "Hetzner" for Hetzner Object Storage, "Other"/"AWS" for B2 S3-API.
BACKUP_S3_PROVIDER=Other
BACKUP_RCLONE_REMOTE=s3:taxi-backups
BACKUP_S3_ACCESS_KEY_ID=your-s3-access-key
BACKUP_S3_SECRET_ACCESS_KEY=your-s3-secret-key
# Hetzner: https://<region>.your-objectstorage.com  |  Backblaze: https://s3.<region>.backblazeb2.com
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_REGION=fsn1

# ── Optional metrics stack (--profile ops) ───────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
