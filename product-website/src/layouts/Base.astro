---
// Base layout — owns <head> (SEO/OG/JSON-LD/hreflang/fonts) and page chrome.
// Ported from reference/index.html lines ~3-42. The page supplies the
// Navigation and Footer via the `header`/`footer` slots so this layout stays
// free of hardcoded, user-facing copy.
import '../styles/tokens.css'
import '../styles/global.css'

interface Props {
  locale: 'cs' | 'en'
  title: string
  description: string
  // og:description is a distinct marketing string in the reference; defaults to
  // description when omitted. og:title is identical to <title> in the reference.
  ogDescription?: string
  skipLabel: string
}

const { locale, title, description, ogDescription, skipLabel } = Astro.props

const ogLocale = locale === 'cs' ? 'cs_CZ' : 'en_US'
const ogLocaleAlt = locale === 'cs' ? 'en_US' : 'cs_CZ'
// Canonical origin comes from astro.config `site` (Astro.site). Per-locale
// canonical: cs -> "/", en -> "/en/". NOTE: deviates from reference line 10 which
// pointed the en hreflang at "/#en"; per the assignment en now lives at /en/.
const origin = Astro.site?.origin ?? 'https://taxi-carfleet.com'
const canonical = locale === 'cs' ? `${origin}/` : `${origin}/en/`
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="cs" href={`${origin}/`} />
    <link rel="alternate" hreflang="en" href={`${origin}/en/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta name="theme-color" content="#AD4F09" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Self-hosted variable Manrope (Latin + latin-ext + Cyrillic, one file); @font-face in src/styles/global.css. No external webfont CDN — see docs/fonts.md. -->
    <link
      rel="preload"
      href="/fonts/Manrope-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            name: 'Taxi Fleet',
            url: `${origin}/`,
            telephone: '+420123456789',
            email: 'info@example.cz',
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Kolín',
              addressCountry: 'CZ',
            },
          },
          {
            '@type': 'SoftwareApplication',
            name: 'Taxi Fleet',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web, Android, iOS (PWA)',
            description:
              'Objednávací aplikace pro zákazníky, aplikace pro řidiče a dispečink pro malé taxislužby.',
            offers: [
              {
                '@type': 'Offer',
                name: 'Malá flotila (do 3 aut)',
                price: '1490',
                priceCurrency: 'CZK',
                description: 'měsíčně bez DPH',
              },
              {
                '@type': 'Offer',
                name: 'Střední flotila (4–6 aut)',
                price: '2490',
                priceCurrency: 'CZK',
                description: 'měsíčně bez DPH',
              },
              {
                '@type': 'Offer',
                name: 'Velká flotila (7–10 aut)',
                price: '3490',
                priceCurrency: 'CZK',
                description: 'měsíčně bez DPH',
              },
            ],
            inLanguage: ['cs', 'en', 'de', 'ru', 'uk', 'fil'],
          },
          {
            '@type': 'FAQPage',
            mainEntity: [
              {
                '@type': 'Question',
                name: 'Proč ne Bolt nebo Liftago?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Zprostředkovatel vlastní zákazníka, určuje cenu a bere si provizi. Vaše aplikace vlastní vás: cenu i zákazníka. Jezdit pro ně můžete dál, vedle toho.',
                },
              },
              {
                '@type': 'Question',
                name: 'Není to v App Storu. Nevadí to?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Zákazník otevře odkaz a přidá si ikonu na plochu – dvě ťuknutí. Nečekáte na schválení, aktualizace jsou okamžité a aplikace je pod vaším jménem, ne pod účtem dodavatele.',
                },
              },
              {
                '@type': 'Question',
                name: 'Potřebuji někoho na dispečinku?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Ne nutně. Objednávky z aplikace přicházejí samy a přiřadit auto zvládne majitel z notebooku nebo tabletu. Když dispečink máte, dostane přehlednou obrazovku místo sešitu.',
                },
              },
              {
                '@type': 'Question',
                name: 'Co když vypadne internet?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Zákazník vidí tlačítko Zavolat a vaše číslo. Řidič má jízdu uloženou v telefonu a pokračuje, jakmile se připojí.',
                },
              },
              {
                '@type': 'Question',
                name: 'Jak dlouho trvá zavedení?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Obvykle do týdne od telefonátu. Nastavíme barvu, logo, telefon, pevné trasy a řidiče; vy rozdáte odkaz.',
                },
              },
              {
                '@type': 'Question',
                name: 'Kde jsou data?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Na serverech v EU, každá taxislužba odděleně. Objednávky, zákazníky i reporty si kdykoli stáhnete v CSV.',
                },
              },
              {
                '@type': 'Question',
                name: 'Můžu odejít?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Ano, kdykoli. Bez smlouvy na dobu určitou, data si odnesete.',
                },
              },
              {
                '@type': 'Question',
                name: 'Co když přidám auto?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Nic se nemění, dokud nepřekročíte hranici tarifu. Když ji překročíte na celý měsíc, přejdete od dalšího měsíce na vyšší tarif. Zpět můžete kdykoli.',
                },
              },
              {
                '@type': 'Question',
                name: 'Platím za řidiče?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Ne. Řidičů můžete mít, kolik chcete. Počítají se auta.',
                },
              },
            ],
          },
        ],
      })}
    />
  </head>
  <body>
    <a class="skip" href="#top">{skipLabel}</a>
    <slot name="header" />
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
