---
// Inline-SVG icon set extracted verbatim from reference/index.html.
// Presentational: aria-hidden by default; pass `label` to expose it as an image.
export type IconName = 'car' | 'phone' | 'check' | 'plus' | 'menu' | 'globe' | 'device' | 'currency'

interface Props {
  name: IconName
  label?: string
  class?: string
}

const { name, label, class: className } = Astro.props

// Each entry is the inner markup of a `viewBox="0 0 24 24"` glyph, copied
// verbatim from the reference.
const glyphs: Record<IconName, string> = {
  car: '<path d="M5 17h14M6 17l1.5-6h9L18 17M8 11l1-3h6l1 3"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  check: '<path d="M5 12l4 4L19 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  device: '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M10 18h4"/>',
  currency: '<path d="M12 3v18M7 8.5a4 3 0 0 1 4-2.5h2a3.5 3 0 0 1 0 6h-2a3.5 3 0 0 0 0 6h2a4 3 0 0 0 4-2.5"/>',
}

const role = label ? 'img' : undefined
const ariaLabel = label ?? undefined
const ariaHidden = label ? undefined : 'true'
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  role={role}
  aria-label={ariaLabel}
  aria-hidden={ariaHidden}
  set:html={glyphs[name]}
/>

<style>
  .icon {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
</style>
