---
// Interactive price calculator (reference #pricing .calc block). The client
// behaviour lives in ../scripts/pricingCalculator.ts, imported by the processed
// <script> below so Astro bundles it into an EXTERNAL same-origin /_astro/*.js
// file — required because the apex site runs under a strict CSP (`script-src
// 'self'`, infra/Caddyfile) that blocks inline scripts (an is:inline or inlined
// `type=module` script is refused). Per-locale config (tier labels, savings
// template, min/max, comparison constants, the page locale for auto/auta/aut
// pluralization) is passed via the `.calc` element's `data-calc-config` JSON
// attribute (JSON is not executable → CSP-safe) instead of `define:vars`.
//
// Scope note: only the .calc* CSS lives here (the range, steppers, result
// panels). The .tiers/.tier* cards + .price-foot render in HomeSections, so
// their CSS lives in HomeSections' global <style> — the calculator script
// toggles .is-active on .tier articles document-wide regardless of CSS scope.
import type { Locale } from '../i18n/t'

export interface CalcScriptVars {
  /** Page locale — drives the client-side car-count pluralization (cs: auto/auta/aut). */
  locale: Locale
  /** Composed tier pill labels keyed by tier code (e.g. "Malá flotila · do 3 aut"). */
  tierLabels: Record<'small' | 'medium' | 'large' | 'custom', string>
  /** Savings-pill template with an {x} placeholder for the formatted amount. */
  saveTemplate: string
  /** Custom-tier price word ("individuálně" / "individually"). */
  indiv: string
  /** −/+ stepper aria-labels. */
  minusAria: string
  plusAria: string
  /** Range bounds + starting value + comparison constants. */
  min: number
  max: number
  initial: number
  licPerDriver: number
  appFee: number
}

interface Props {
  locale: Locale
  /** Initial rendered strings (SSR values; the script re-derives on the client). */
  labelText: string
  carsInitial: string
  yoursLabel: string
  priceInitial: string
  perMonth: string
  tierInitial: string
  customText: string
  compareLabel: string
  comparePriceInitial: string
  perMonth2: string
  compareNote: string
  savingInitial: string
  minusAria: string
  plusAria: string
  min: number
  max: number
  initial: number
  scriptVars: CalcScriptVars
}

const {
  labelText,
  carsInitial,
  yoursLabel,
  priceInitial,
  perMonth,
  tierInitial,
  customText,
  compareLabel,
  comparePriceInitial,
  perMonth2,
  compareNote,
  savingInitial,
  minusAria,
  plusAria,
  min,
  max,
  initial,
  scriptVars,
} = Astro.props
---

<div class="calc" data-calc-config={JSON.stringify(scriptVars)}>
  <div class="calc-ctl">
    <label for="calc-cars" class="calc-label">{labelText}</label>
    <div class="calc-row">
      <button type="button" class="stepbtn" id="calc-minus" aria-label={minusAria}>−</button>
      <output id="calc-cars-out" for="calc-cars" class="calc-val" aria-live="off">{carsInitial}</output>
      <button type="button" class="stepbtn" id="calc-plus" aria-label={plusAria}>+</button>
    </div>
    <input
      type="range"
      id="calc-cars"
      min={min}
      max={max}
      value={initial}
      step="1"
      aria-label={labelText}
      aria-valuetext={carsInitial}
    />
    <div class="calc-ticks" aria-hidden="true"><span>1</span><span>5</span><span>10</span><span>15</span></div>
  </div>
  <div class="calc-res" aria-live="polite">
    <div class="calc-yours">
      <span class="caption">{yoursLabel}</span>
      <div class="calc-price">
        <span id="calc-price">{priceInitial}</span>
        <span class="calc-per" id="calc-per">{perMonth}</span>
      </div>
      <span class="pill pill-accent" id="calc-tier">{tierInitial}</span>
      <p class="caption" id="calc-custom" hidden>{customText}</p>
    </div>
    <div class="calc-cmp" id="calc-cmp">
      <span class="caption">{compareLabel}</span>
      <div class="calc-cmp-price">
        <s id="calc-cmp-price">{comparePriceInitial}</s>
        <span class="calc-per">{perMonth2}</span>
      </div>
      <p class="caption">{compareNote}</p>
      <span class="pill pill-success" id="calc-saving">{savingInitial}</span>
    </div>
  </div>
</div>

<script>
  import '../scripts/pricingCalculator.ts'
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 28px;
    margin-bottom: 20px;
    align-items: center;
  }
  .calc-ctl {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .calc-label {
    font-size: 17px;
    font-weight: 700;
  }
  .calc-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .stepbtn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 22px;
    font-weight: 700;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .stepbtn:hover {
    background: var(--surface-2);
  }
  .calc-val {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
    min-width: 5.5ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    height: 32px;
    margin: 0;
  }
  .calc-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-3);
    padding: 0 4px;
  }
  .calc-res {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .calc-yours,
  .calc-cmp {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    padding: 18px;
    border-radius: var(--r-md);
  }
  .calc-yours {
    background: var(--accent-soft);
  }
  .calc-cmp {
    background: var(--surface-2);
  }
  .calc-price {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  .calc-cmp-price {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .calc-per {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-2);
    letter-spacing: 0;
  }
  /* The #calc-tier / #calc-saving pills are raw spans (the script updates them by
     id; Pill.astro takes no id prop), so Pill.astro's scoped .pill rules cannot
     reach them. Port the .pill base + the two variants used here into this
     component's scope. white-space:normal (not the base nowrap) so the long
     composed tier label + savings sentence wrap inside the result panels — the
     same relaxation the reference applied globally in its pricing block. */
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: normal;
    line-height: 1.2;
  }
  .pill-accent {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .pill-success {
    background: var(--success-bg);
    color: var(--success);
  }
  @media (max-width: 860px) {
    .calc {
      grid-template-columns: 1fr;
      padding: 22px;
    }
    .calc-res {
      grid-template-columns: 1fr;
    }
  }
</style>
