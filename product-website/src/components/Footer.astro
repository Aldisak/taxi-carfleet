---
// Site footer. Ports the footer block from reference/index.html.
// Presentational: all user-facing text arrives via props (no i18n here).
interface Props {
  companyLine: string
  privacyLabel: string
  termsLabel: string
  privacyHref?: string
  termsHref?: string
  attributionLine: string
}

const {
  companyLine,
  privacyLabel,
  termsLabel,
  privacyHref = '#contact',
  termsHref = '#contact',
  attributionLine,
} = Astro.props
---

<footer>
  <div class="wrap">
    <div>{companyLine}</div>
    <div>
      <a href={privacyHref}>{privacyLabel}</a> ·
      <a href={termsHref}>{termsLabel}</a>
    </div>
    <div>{attributionLine}</div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 28px 40px;
  }
  footer .wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 600;
  }
  footer a {
    color: var(--ink-2);
  }
</style>
